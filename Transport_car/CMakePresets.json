{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
		    "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {
            }
        },
        {
            "name": "Debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "Offline30cm",
            "inherits": "Debug",
            "cacheVariables": { "CHASSIS_OFFLINE_30CM": "ON" }
        },
        {
            "name": "Offline1m",
            "inherits": "Offline30cm",
            "cacheVariables": {
                "CHASSIS_TEST_DISTANCE_MM": "1000.0",
                "CHASSIS_TEST_TIMEOUT_MS": "20000"
            }
        },
        {
            "name": "OfflineTurn90",
            "inherits": "Debug",
            "cacheVariables": {
                "CHASSIS_OFFLINE_TURN90": "ON",
                "CHASSIS_TEST_TIMEOUT_MS": "15000"
            }
        },
        {
            "name": "Release",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Debug",
            "configurePreset": "Debug"
        },
        {
            "name": "Offline30cm",
            "configurePreset": "Offline30cm"
        },
        {
            "name": "Offline1m",
            "configurePreset": "Offline1m"
        },
        {
            "name": "OfflineTurn90",
            "configurePreset": "OfflineTurn90"
        },
        {
            "name": "Release",
            "configurePreset": "Release"
        }
    ]
}
